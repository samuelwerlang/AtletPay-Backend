{
  "name": "atletpay",
  "type": "module",
  "version": "1.0.0",
  "description": "mvp backend with expressjs",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "start": "node build/server.js",
    "dev:watch": "tsx watch src/server.ts",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "prisma:g": "prisma generate",
    "prisma:m": "prisma migrate dev",
    "prisma:st": "prisma studio",
    "stripe:listen/platform": "stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.deleted,customer.subscription.updated,invoice.paid,invoice.payment_succeeded,invoice.payment_failed --forward-to http://localhost:8080/webhook/stripe/platform",
    "stripe:listen/connect": "stripe listen --forward-to http://localhost:8080/webhook/stripe/connect"
  },
  "author": "Samuel Werlang",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.5",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "prisma": "^7.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/stripe": "^8.0.416",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.7.2",
    "express-rate-limit": "^8.2.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "stripe": "^20.3.1",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  }
}
