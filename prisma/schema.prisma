generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auth0Id      String        @unique
  name         String?       @unique
  expenses     Expense[]
  students     Student[]
  subscription Subscription?
  plans        UserPlan[]
}

model Student {
  id               String            @id @default(uuid())
  email            String?
  phone            String?
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())
  name             String
  userId           String
  charges          Charge[]
  recurringCharges RecurringCharge[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans            StudentPlan[]

  @@index([userId])
}

model Expense {
  id          String           @id @default(uuid())
  name        String
  description String?
  amount      Int
  date        DateTime
  category    EXPENSE_CATEGORY
  userId      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Charge {
  id          String       @id @default(uuid())
  amount      Int
  dueDate     DateTime
  status      ChargeStatus
  description String?
  studentId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model RecurringCharge {
  id        String          @id @default(uuid())
  amount    Int
  interval  BillingInterval
  startDate DateTime
  active    Boolean         @default(true)
  studentId String
  createdAt DateTime        @default(now())
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model UserPlan {
  id              String        @id @default(uuid())
  name            String
  price           Int
  sessionsPerWeek Int
  durationInWeeks Int
  description     String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  studentPlans    StudentPlan[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentPlan {
  id              String            @id @default(uuid())
  studentId       String
  planId          String
  status          StudentPlanStatus @default(ACTIVE)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  priceAtPurchase Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  plan            UserPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([planId])
}

model SaasPlan {
  id            String         @id @default(uuid())
  name          String
  price         Int
  StripePriceId String         @unique
  maxStudents   Int?
  maxPlans      Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  type          SaasPlanType   @unique
  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  status               SubscriptionStatus @default(ACTIVE)
  userId               String             @unique
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  currentPeriodEnd     DateTime
  currentPeriodStart   DateTime
  saasPlanId           String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  updatedAt            DateTime           @updatedAt
  saasPlan             SaasPlan           @relation(fields: [saasPlanId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  ADMIN
}

enum SaasPlanType {
  FREE
  BASIC
  PRO
  PREMIUM
}

enum StudentPlanStatus {
  ACTIVE
  INACTIVE
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum BillingInterval {
  MONTHLY
  WEEKLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

enum EXPENSE_CATEGORY {
  EQUIPMENT
  MARKETING
  RENT
  TRANSPORTATION
  FEEDING
  OTHERS
}
