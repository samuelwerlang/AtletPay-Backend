generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auth0Id      String        @unique
  stripeCustomerId String?   @unique // Stripe Customer ID
  stripeAccountId  String?       @unique //Stripe Connect
  name         String?       @unique
  expenses     Expense[]
  students     Student[]
  subscription Subscription[]
  plans        UserPlan[]
  trainingSheets TrainingSheet[]
  dietPlans     DietPlan[]
  meals         Meal[]
}

model Student {
  id               String            @id @default(uuid())
  email            String?
  phone            String?
  name             String
  isActive         Boolean           @default(false)
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentPlans            StudentPlan[]
  trainingSheets   TrainingSheet[]
  dietPlans        DietPlan[]
  @@index([userId])
}

model TrainingSheet {
  id          String                  @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime?
  userId      String
  studentId   String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student     Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exercises   TrainingSheetExercise[]

  @@index([userId])
  @@index([studentId])
}

model TrainingSheetExercise {
  id               String        @id @default(uuid())
  trainingSheetId  String
  exerciseName     String
  sets             Int
  repetitions      String
  notes            String?
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  trainingSheet    TrainingSheet @relation(fields: [trainingSheetId], references: [id], onDelete: Cascade)

  @@index([trainingSheetId])
  @@index([order])
}

model DietPlan {
  id          String       @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  userId      String
  studentId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meals       DietPlanMeal[]

  @@index([userId])
  @@index([studentId])
}

model Meal {
  id           String       @id @default(uuid())
  name         String
  quantity     String?
  kcal         Int?
  substitutes  String?
  notes        String?
  userId       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietPlans    DietPlanMeal[]

  @@index([userId])
}

model DietPlanMeal {
  id          String    @id @default(uuid())
  dietPlanId  String
  mealId      String
  mealOrder   Int       @default(0)
  mealTime    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dietPlan    DietPlan  @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  meal        Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([dietPlanId])
  @@index([mealId])
  @@unique([dietPlanId, mealOrder])
}

model Expense {
  id          String           @id @default(uuid())
  name        String
  description String?
  amount      Int
  date        DateTime
  category    EXPENSE_CATEGORY
  userId      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Charge {
  id             String        @id @default(uuid())
  studentPlanId  String?       // vincula ao plano do aluno, preenchido após pagamento
  studentId      String        // aluno que vai pagar
  amount         Int           // em centavos
  currency       String        @default("BRL")
  status         ChargeStatus  @default(PENDING) // PENDING | PAID | FAILED | CANCELED
  description    String? // info opcional, ex.: nome do plano
  externalId     String?       // id do Stripe ou outro gateway
  checkoutSessionId String?       // para facilitar reconciliação

  paidAt         DateTime?     // preenchido quando pagamento confirmado
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentPlan    StudentPlan?  @relation(fields: [studentPlanId], references: [id], onDelete: Cascade)

  @@index([studentPlanId])
  @@index([studentId])
}

model UserPlan {
  id               String   @id @default(uuid())
  name             String
  price            Int
  sessionsPerWeek  Int
  durationInMonths  Int? //Opcional para planos não recorrentes

  stripeAccountId  String   // Stripe Connect
  stripeProductId  String
  stripePriceId    String

  description      String
  isActive         Boolean  @default(true)
  isRecurrent      Boolean  @default(false)
  intervalType   UserPlanRecurringIntervalType? // para planos recorrentes

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentPlans     StudentPlan[]

  @@unique([userId, name]) // regra de negócio 
  @@unique([stripeAccountId, stripeProductId])
  @@unique([stripeAccountId, stripePriceId])

  @@index([userId])
  @@index([stripeAccountId])
}

model StudentPlan {
  id              String            @id @default(uuid())
  studentId       String             
  userPlanId      String
  stripeId        String             @unique // id do plano no Stripe, para facilitar reconciliação
  status          StudentPlanStatus @default(ACTIVE)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  priceAtPurchase Int
  charges         Charge[]
  // recurringCharges RecurringCharge[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  plan            UserPlan          @relation(fields: [userPlanId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([userPlanId])
}

model SaasPlan {
  id            String         @id @default(uuid())
  name          String
  price         Int
  StripePriceId String         @unique
  maxStudents   Int?
  maxPlans      Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  type          SaasPlanType   @unique
  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  status               SubscriptionStatus 
  userId               String             
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  currentPeriodEnd     DateTime
  currentPeriodStart   DateTime
  saasPlanId           String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  updatedAt            DateTime           @updatedAt
  saasPlan             SaasPlan           @relation(fields: [saasPlanId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  STUDENT
  ADMIN
}

enum SaasPlanType {
  FREE
  BASIC
  PRO
  PREMIUM
}

enum StudentPlanStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  UNPAID
  TRIALING
  PAUSED
  PROCESSING
  INCOMPLETE_EXPIRED
  REQUIRES_ACTION
  REQUIRES_CAPTURE
  REQUIRES_CONFIRMATION
  REQUIRES_PAYMENT_METHOD
  SUCCEEDED
  EXPIRED
}

enum ChargeStatus {
  PENDING
  PAID
  FAILED
}

enum BillingInterval {
  MONTHLY
  WEEKLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  UNPAID
  TRIALING
}

enum EXPENSE_CATEGORY {
  EQUIPMENT
  MARKETING
  RENT
  TRANSPORTATION
  FEEDING
  OTHERS
}

enum UserPlanRecurringIntervalType {
  MONTHLY
  BIMONTHLY
  TRIMONTHLY
  SEMIANNUALLY
  ANUALLY
}