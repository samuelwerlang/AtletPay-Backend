// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PERSONAL
  ADMIN
}
enum SAAS_PLAN_TYPE {
  FREE
  BASIC
  PRO 
  PREMIUM
}

enum StudentPlanStatus {
  ACTIVE
  INACTIVE
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum BillingInterval {
  MONTHLY
  WEEKLY
}
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
} 

enum EXPENSE_CATEGORY {
  EQUIPMENT
  MARKETING
  RENT
  TRANSPORTATION
  FEEDING
  OTHERS
}


model User {
  id  String @id @default(uuid())
  auth0Id String @unique
  email String @unique
  name String? @unique
  role UserRole @default(PERSONAL)

  students Student[]
  expenses Expense[]
  plans PersonalPlan[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id String @id @default(uuid())
  name String
  email String?
  phone String? 
  plans StudentPlan[]
  personalId String
  personal User @relation(fields: [personalId], references: [id])


  charges Charge[]
  recurringCharges RecurringCharge[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([personalId])
}

model Expense {
  id String @id @default(uuid())
  name String
  description String?
  amount Int //Cents
  date DateTime
  category EXPENSE_CATEGORY

  userId String
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Charge {
  id String @id @default(uuid())
  amount Int //cents
  dueDate DateTime 
  status ChargeStatus
  description String?

  studentId String
  student Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model RecurringCharge {
  id String @id @default(uuid())
  amount Int 
  interval BillingInterval 
  startDate DateTime
  active Boolean @default(true)

  studentId String
  student Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
}

model PersonalPlan {
  id String @id @default(uuid())
  name String
  price Int //cents
  sessionsPerWeek Int
  durationInWeeks Int
  description String

  isActive Boolean @default(true)
  personalId String
  personal User @relation(fields: [personalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentPlans StudentPlan[]

  @@index([personalId])
}

model StudentPlan {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  planId String
  plan PersonalPlan @relation(fields: [planId], references: [id])

  status StudentPlanStatus @default(ACTIVE)

  startDate DateTime @default(now())
  endDate DateTime?

  priceAtPurchase Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([planId])
}

model SaasPlan {
  id String @id @default(uuid())
  saasPlanType SAAS_PLAN_TYPE @unique

  name String
  price Int //cents

  StripePriceId String @unique

  maxStudents Int?
  maxPlans Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(uuid())
  status SubscriptionStatus @default(ACTIVE)

  userId String @unique
  user User @relation(fields: [userId], references: [id])

  saasPlanId String
  saasPlan SaasPlan @relation(fields: [saasPlanId], references: [id])

  stripeSubscriptionId String @unique
  stripeCustomerId String

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}