model UserPlan {
  id               String   @id @default(uuid())
  name             String
  price            Int
  sessionsPerWeek  Int
  durationInMonths  Int

  stripeAccountId  String   // Stripe Connect
  stripeProductId  String
  stripePriceId    String

  description      String
  isActive         Boolean  @default(true)
  isRecurrent      Boolean  @default(false)
  intervalType   UserPlanRecurringIntervalType? // para planos recorrentes

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentPlans     StudentPlan[]

  @@unique([userId, name]) // regra de negócio 
  @@unique([stripeAccountId, stripeProductId])
  @@unique([stripeAccountId, stripePriceId])

  @@index([userId])
  @@index([stripeAccountId])
}

model StudentPlan {
  id              String            @id @default(uuid())
  studentId       String
  planId          String
  status          StudentPlanStatus @default(ACTIVE)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  priceAtPurchase Int
  charges         Charge[]
  // recurringCharges RecurringCharge[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  plan            UserPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([planId])
}

model SaasPlan {
  id            String         @id @default(uuid())
  name          String
  price         Int
  StripePriceId String         @unique
  maxStudents   Int?
  maxPlans      Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  type          SaasPlanType   @unique
  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  status               SubscriptionStatus @default(ACTIVE)
  userId               String             
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  currentPeriodEnd     DateTime
  currentPeriodStart   DateTime
  saasPlanId           String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  updatedAt            DateTime           @updatedAt
  saasPlan             SaasPlan           @relation(fields: [saasPlanId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  ADMIN
}

enum SaasPlanType {
  FREE
  BASIC
  PRO
  PREMIUM
}

enum StudentPlanStatus {
  ACTIVE
  INACTIVE
}

enum ChargeStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum BillingInterval {
  MONTHLY
  WEEKLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  UNPAID
  TRIALING
}

enum EXPENSE_CATEGORY {
  EQUIPMENT
  MARKETING
  RENT
  TRANSPORTATION
  FEEDING
  OTHERS
}

enum UserPlanRecurringIntervalType {
  MONTHLY
  BIMONTHLY
  TRIMONTHLY
  SEMIANNUALLY
  ANUALLY
}