generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auth0Id      String        @unique
  stripeCustomerId String?   @unique
  name         String?       @unique
  expenses     Expense[]
  students     Student[]
  subscription Subscription?
  plans        UserPlan[]
}

model Student {
  id               String            @id @default(uuid())
  email            String?
  phone            String?
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())
  name             String
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans            StudentPlan[]
  @@index([userId])
}

model Expense {
  id          String           @id @default(uuid())
  name        String
  description String?
  amount      Int
  date        DateTime
  category    EXPENSE_CATEGORY
  userId      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Charge {
  id             String        @id @default(uuid())
  amount         Int           // em centavos (minor units)
  currency       String        @default("BRL")
  dueDate        DateTime
  status         ChargeStatus  @default(PENDING)
  description    String?
  studentPlanId  String
  // denormalizado para facilitar filtros:
  studentId      String
  externalId     String?       // id do gateway (Stripe, etc.)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentPlan    StudentPlan   @relation(fields: [studentPlanId], references: [id], onDelete: Cascade)

  @@index([studentPlanId])
  @@index([studentId])
  @@unique([studentPlanId, dueDate])
}

model RecurringCharge {
  id             String           @id @default(uuid())
  amount         Int              // em centavos (minor units)
  currency       String           @default("BRL")
  interval       BillingInterval  @default(MONTHLY)
  startDate      DateTime         // início da recorrência
  nextRunAt      DateTime         // próxima geração de cobrança
  lastRunAt      DateTime?        // última execução
  anchorDayOfMonth Int?           // opcional: para ciclos mensais (ex.: dia 15)
  status         RecurringStatus  @default(ACTIVE)

  studentPlanId  String
  studentId      String           // denormalizado para filtros

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  studentPlan    StudentPlan      @relation(fields: [studentPlanId], references: [id], onDelete: Cascade)

  @@index([studentPlanId])
  @@index([studentId])
}

model UserPlan {
  id              String        @id @default(uuid())
  name            String
  price           Int
  sessionsPerWeek Int
  durationInWeeks Int
  description     String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String
  studentPlans    StudentPlan[]

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentPlan {
  id              String            @id @default(uuid())
  studentId       String
  planId          String
  status          StudentPlanStatus @default(ACTIVE)
  startDate       DateTime          @default(now())
  endDate         DateTime?
  priceAtPurchase Int
  charges         Charge[]
  recurringCharges RecurringCharge[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  plan            UserPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([planId])
}

model SaasPlan {
  id            String         @id @default(uuid())
  name          String
  price         Int
  StripePriceId String         @unique
  maxStudents   Int?
  maxPlans      Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  type          SaasPlanType   @unique
  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  status               SubscriptionStatus @default(ACTIVE)
  userId               String             @unique
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  currentPeriodEnd     DateTime
  currentPeriodStart   DateTime
  saasPlanId           String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  updatedAt            DateTime           @updatedAt
  saasPlan             SaasPlan           @relation(fields: [saasPlanId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  ADMIN
}

enum SaasPlanType {
  FREE
  BASIC
  PRO
  PREMIUM
}

enum StudentPlanStatus {
  ACTIVE
  INACTIVE
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum BillingInterval {
  MONTHLY
  WEEKLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  UNPAID
  TRIALING
}

enum EXPENSE_CATEGORY {
  EQUIPMENT
  MARKETING
  RENT
  TRANSPORTATION
  FEEDING
  OTHERS
}
